temperature = float(input("Enter room temperature: "))
light = input("Is it dark? (yes/no): ")
motion = input("Is anyone in the room? (yes/no): ")
door = input("Is the door open? (yes/no): ")

if temperature > 28:
    print("Turn ON Air Conditioner")
elif temperature < 18:
    print("Turn ON Heater")
else:
    print("Temperature is comfortable")

if light == "yes" and motion == "yes":
    print("Turn ON Lights")
else:
    print("Turn OFF Lights")

if motion == "no":
    print("Room is empty. Save energy")

if door == "yes":
    print("Door is open")
else:
    print("Door is closed")
